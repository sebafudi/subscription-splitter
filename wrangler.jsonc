{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subscription-splitter",
  "main": "./src/server/index.ts",
  // Held at the newest date the runtime bundled with @cloudflare/vitest-pool-workers
  // supports, so the integration suite and wrangler run the same Worker semantics.
  "compatibility_date": "2026-08-22",
  // Better Auth needs AsyncLocalStorage for request context (decision D-001).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The Vite plugin fills in assets.directory at build time; only the
    // client-routing fallback is set by hand.
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subscription-splitter-db",
      "database_id": "03067638-dc95-4b5c-9a8a-86f2921e0414",
      "migrations_dir": "migrations"
    }
  ]
}
