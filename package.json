{
  "name": "subscription-splitter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply subscription-splitter-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply subscription-splitter-db --remote",
    "seed:local": "echo 'Account seeding lands with the runtime-auth slice (S-01). See context/foundation/roadmap.md.' && exit 1",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "better-auth": "1.7.4",
    "hono": "4.13.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20260911.1": true,
    "esbuild@0.28.1": true
  }
}
