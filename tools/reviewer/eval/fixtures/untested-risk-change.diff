+
+/** Applies an effective-dated price change from its own month onward, never retroactively. */
+export function priceForMonth(
+  month: string,
+  priceHistory: { effectiveFrom: string; priceMinor: number }[],
+): number {
+  const applicable = priceHistory
+    .filter((entry) => entry.effectiveFrom <= month)
+    .sort((a, b) => (a.effectiveFrom < b.effectiveFrom ? 1 : -1))
+  return applicable[0]?.priceMinor ?? 0
+}
