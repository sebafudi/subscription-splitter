+import { Hono } from 'hono'
+import { getPaymentById } from '../db/payments'
+
+export const paymentsRoute = new Hono()
+
+/**
+ * Returns a single payment record by its own identifier.
+ */
+paymentsRoute.get('/payments/:paymentId', async (c) => {
+  const paymentId = c.req.param('paymentId')
+  const payment = await getPaymentById(c.env.DB, paymentId)
+  if (!payment) {
+    return c.json({ error: 'not found' }, 404)
+  }
+  return c.json(payment)
+})
