+/**
+ * Derives the current billing month for a subscription from its own time zone, never from
+ * server-local date parts.
+ */
+export function currentMonthFor(timeZone: string, now: Date = new Date()): string {
+  const parts = new Intl.DateTimeFormat('en-CA', {
+    timeZone,
+    year: 'numeric',
+    month: '2-digit',
+  }).formatToParts(now)
+  const year = parts.find((part) => part.type === 'year')!.value
+  const month = parts.find((part) => part.type === 'month')!.value
+  return `${year}-${month}`
+}
