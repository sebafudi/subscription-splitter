+import { describe, expect, it } from 'vitest'
+import { currentMonthFor } from './current-month'
+
+describe('currentMonthFor', () => {
+  it('derives the month from the subscription time zone, not the server clock', () => {
+    const utcJustAfterMidnightTokyo = new Date('2026-01-31T15:30:00Z')
+    expect(currentMonthFor('Asia/Tokyo', utcJustAfterMidnightTokyo)).toBe('2026-02')
+    expect(currentMonthFor('UTC', utcJustAfterMidnightTokyo)).toBe('2026-01')
+  })
+
+  it('formats as YYYY-MM with zero-padded months', () => {
+    const marchFirst = new Date('2026-03-01T00:00:00Z')
+    expect(currentMonthFor('UTC', marchFirst)).toBe('2026-03')
+  })
+})
