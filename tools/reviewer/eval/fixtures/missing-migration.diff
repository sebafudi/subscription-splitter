+import type { D1Database } from '@cloudflare/workers-types'
+
+export interface ParticipantRow {
+  id: string
+  subscription_id: string
+  display_name: string
+  loyalty_tier: string
+}
+
+/**
+ * Reads a participant's loyalty tier for the upcoming membership rewards feature.
+ */
+export async function getParticipantLoyaltyTier(
+  db: D1Database,
+  participantId: string,
+): Promise<string | null> {
+  const row = await db
+    .prepare('SELECT loyalty_tier FROM participants WHERE id = ?')
+    .bind(participantId)
+    .first<{ loyalty_tier: string }>()
+  return row?.loyalty_tier ?? null
+}
